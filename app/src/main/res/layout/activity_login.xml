<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <View
        android:id="@+id/bgBase"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="460dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Flux"
                    android:textColor="@color/text"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Connecte ton abonnement IPTV (Xtream)"
                    android:textColor="@color/white_80"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/server"
                    style="@style/FluxInput"
                    android:layout_marginTop="32dp"
                    android:hint="Adresse du serveur (ex : http://exemple.com:8080)"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/username"
                    style="@style/FluxInput"
                    android:hint="Identifiant"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/password"
                    style="@style/FluxInput"
                    android:hint="Mot de passe"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#FF8A8A"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp">

                    <Button
                        android:id="@+id/connect"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/button_bg"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="Se connecter"
                        android:textAllCaps="false"
                        android:textColor="@color/pill_text"
                        android:textSize="17sp" />

                    <ProgressBar
                        android:id="@+id/progress"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/text"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="ou"
                    android:textColor="@color/white_60"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/free"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/pill_bg"
                        android:drawableStart="@drawable/ic_play"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/pill_text"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="20dp"
                        android:paddingEnd="22dp"
                        android:stateListAnimator="@null"
                        android:text="Chaînes gratuites"
                        android:textAllCaps="false"
                        android:textColor="@color/pill_text"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/m3u"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/pill_bg"
                        android:drawableStart="@drawable/ic_login"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/pill_text"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="20dp"
                        android:paddingEnd="22dp"
                        android:stateListAnimator="@null"
                        android:text="Lien M3U"
                        android:textAllCaps="false"
                        android:textColor="@color/pill_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/later"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/pill_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="@color/pill_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
